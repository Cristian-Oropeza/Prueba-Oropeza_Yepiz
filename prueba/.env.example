# Local dev con docker-compose
SPRING_PROFILES_ACTIVE=prod
JWT_ENABLED=false
JWT_SECRET=un-secreto-super-largo-de-al-menos-64-caracteres-para-desarrollo-local
CUENTA_SALDO_INICIAL=0.00
CUENTA_PREFIJO_CLABE=014180

# ============================================================
# GestoPago / PuntoRed - Modulo de transacciones
# ============================================================
# Las credenciales del distribuidor 83 son PUBLICAS de la documentacion de PuntoRed
# y sirven para el ambiente de pruebas. En produccion real, PuntoRed asigna otras.
GESTOPAGO_ENABLED=true
GESTOPAGO_ID_DISTRIBUIDOR=83
GESTOPAGO_CODIGO_DISPOSITIVO=GPS83-TPV-17
GESTOPAGO_AUTH_PASSWORD=12345678
GESTOPAGO_TX_UNIDAD=083

# Llave e IV AES-256 Base64 (compartidas de prueba del distribuidor 83).
# En produccion vienen asignadas por PuntoRed. NO comitear llaves reales en el repo.
GESTOPAGO_CIFRADO_LLAVE=HPo7OLqB4Fkk4E2yGOtwqw8H5fHR9kNx67OR4g4UdlA=
GESTOPAGO_CIFRADO_IV=p5ldmBPdd/9pjC0bDC/nSg==

# X-API-Key opcional del comercio (dejar vacio si no fue asignada).
GESTOPAGO_API_KEY=

# Scheduler de conciliacion: dejalo en false hasta validar el flujo basico contra el proveedor.
GESTOPAGO_CONCILIACION_ENABLED=false
